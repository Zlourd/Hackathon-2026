{
  "manifest_version": 3,
  "name": "Become Nobody.",
  "version": "1.0.0",
  "description": "Obfuscation, not silence: feeds trackers a coherent fake persona with decoy interests and browsing, so the profile they build is detailed, confident — and useless.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Become Nobody.",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5172/*",
        "http://127.0.0.1:5172/*",
        "file:///*/polyphemus/index.html"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": [
      "animations/animation.html",
      "polyphemus/index.html"
    ]
  }
}
